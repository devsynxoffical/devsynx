# Devsynx Production Apache Configuration (.htaccess)
RewriteEngine On

# 301 Permanent Redirects for Old Indexed & Consolidated URLs
RewriteRule ^services/cloud-solutions/?$ /services/cloud-migration/ [R=301,L]
RewriteRule ^services/business-process-automation/?$ /services/process-automation/ [R=301,L]
RewriteRule ^solutions/software-application-development/?$ /services/custom-web-development/ [R=301,L]
RewriteRule ^solutions/web-development-company-services/?$ /services/custom-web-development/ [R=301,L]
RewriteRule ^solutions/ai-automation-services/?$ /services/ai-automation/ [R=301,L]
RewriteRule ^solutions/?$ /services/ [R=301,L]
RewriteRule ^global/singapore/web-development/?$ /services/custom-web-development/ [R=301,L]
RewriteRule ^global/?$ /usa/ [R=301,L]

# 1. Disable MultiViews to avoid conflicts with index.html files
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# 2. Set default DirectoryIndex
DirectoryIndex index.html

# 3. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 4. Canonical domain: devsynx.com (redirect www to non-www)
RewriteCond %{HTTP_HOST} ^www\.devsynx\.com$ [NC]
RewriteRule ^(.*)$ https://devsynx.com/$1 [L,R=301]

# Protect against direct browser visits to Next.js RSC index.txt files
RewriteRule ^robots\.txt$ - [L]
RewriteRule ^llms\.txt$ - [L]
RewriteRule ^f9c42b8e3a1d4790b561d87a2e5c9f3b\.txt$ - [L]
RewriteRule ^devsynx2026indexnow4c8f9b2a\.txt$ - [L]

RewriteCond %{HTTP:RSC} ^$
RewriteRule ^(.*)/index\.txt$ /$1/ [R=301,L]

RewriteCond %{HTTP:RSC} ^$
RewriteRule ^index\.txt$ / [R=301,L]

# 5. Serve existing static files & directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 6. Map clean routes (e.g. /about or /about/) to /about/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)$ /$1/index.html [L]

RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L]

# 7. Fallback Error Document
ErrorDocument 404 /404.html

# 8. Enable GZIP compression for all static assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# 9. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/json "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 10. Correct MIME Types
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType application/json .json
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType image/webp .webp
</IfModule>

# 11. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
